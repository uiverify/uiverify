{
  "name": "@uiverify/bun",
  "version": "0.1.0",
  "description": "Bun capture SDK for UI Verify (uiverify.ai): write visual tests with bun test that drive the installed Chrome through Bun.WebView, and each test archives its final DOM (serialized DOM + resource bytes) to be replayed + visually diffed by UI Verify. Produces an archive the uiverify CLI uploads; talks to nothing at runtime.",
  "keywords": [
    "visual-testing",
    "visual-regression",
    "bun",
    "bun-test",
    "screenshot-testing",
    "rrweb",
    "uiverify"
  ],
  "homepage": "https://uiverify.ai",
  "bugs": "https://github.com/uiverify/uiverify/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uiverify/uiverify.git",
    "directory": "packages/bun"
  },
  "license": "MIT",
  "author": "UI Verify",
  "engines": {
    "bun": ">=1.3.12"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./run": {
      "types": "./dist/run.d.ts",
      "default": "./dist/run.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsup",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@rrweb/types": "^2.0.0",
    "@types/bun": "^1.4.3",
    "@uiverify/archive-core": "workspace:*",
    "rrweb-snapshot": "^2.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.7.0"
  }
}
