{
  "name": "uiverify-example-react-native",
  "version": "1.0.0",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "screenshots": "maestro test .maestro/flow.yaml && node scripts/collect-screenshots.mjs",
    "upload": "uiverify upload --screenshots screenshots --only-changed"
  },
  "dependencies": {
    "expo": "^54.0.37",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "pngjs": "^7.0.0",
    "typescript": "~5.9.2",
    "uiverify": "^1.2.1"
  }
}
