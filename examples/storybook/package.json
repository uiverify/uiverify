{
  "name": "uiverify-example-storybook",
  "private": true,
  "type": "module",
  "description": "UI Verify example: capturing Storybook stories. Build the static Storybook, then `uiverify upload --static-dir`.",
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build --stats-json",
    "upload": "uiverify upload --static-dir storybook-static --only-changed"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.4.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "storybook": "^10.4.6",
    "typescript": "^5.7.2",
    "uiverify": "^1.4.0",
    "vite": "^7.0.0"
  }
}
